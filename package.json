    "typescript": "^5.7.3",
    "vitest": "4.1.11",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "ical-generator": "^10.0.0",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "node-ical": "^0.22.1",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "engines": {
    "node": ">=22.12.0"
